# --- env ---
# Glob, not just `.env`: hand-made backups (.env.bak, .env.local, .env.old)
# carry the same live keys and are exactly what gets committed by accident.
.env
.env.*
!.env.example

# --- Python (pipeline/) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Rust (api/) ---
/api/target/
**/*.rs.bk

# --- Node (web/) ---
web/node_modules/
web/dist/
web/.vite/
npm-debug.log*

# --- personal working notes, not part of the repo ---
notes/
