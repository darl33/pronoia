# --- Postgres (docker-compose) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# --- Application DB roles (§2, §6: pipeline writes, API is read-only) ---
# SQLAlchemy dialect+driver form, e.g. postgresql+psycopg://user:pass@host:port/db
PIPELINE_DATABASE_URL=
API_DATABASE_URL=

# --- LLM completions (§5.3 slot 1, §5.4) ---
# One key is enough. The provider, base URL and model are inferred from the key
# prefix: sk-ant- -> Anthropic, sk- -> OpenAI, gsk_ -> Groq, sk-or-v1- ->
# OpenRouter. An unrecognized prefix is not an error, it just means you set
# LLM_BASE_URL yourself.
#
# Leave all three blank to run fully local: Ollama (localhost:11434) and vLLM
# (localhost:8000) are probed at startup and whichever answers is used.
#
# ANTHROPIC_API_KEY / OPENAI_API_KEY are also accepted if you already export one.
LLM_API_KEY=
LLM_BASE_URL=          # any OpenAI-compatible /v1 endpoint; overrides the inferred one
LLM_MODEL=             # overrides the provider's default model

# --- Embeddings (§5.3 slot 2) ---
# Optional, and optional on purpose: Anthropic has no embeddings API, so
# requiring a second key would break the one-key promise. If nothing resolves,
# report.embedding stays NULL and only semantic search degrades (§5.4).
#
# The Rust API reads the same two variables for /search, so a swap is one
# change consumed in two languages (§5.3, §8).
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=     # only if the embedding endpoint differs from the LLM one
EMBEDDING_DIM=         # request a specific vector width; must match report.embedding VECTOR(n)

# Run `uv run pronoia doctor` to see exactly what resolved and what is missing.
